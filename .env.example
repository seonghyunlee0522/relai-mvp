# ---- required ----
DATABASE_URL=postgres://relai:password@127.0.0.1:5432/relai
NODE_ENV=development            # production enables Secure/__Host- cookies and requires SESSION_SECRET
SESSION_SECRET=change-me-32-random-bytes   # keys session token hashes; rotating it logs everyone out

# ---- optional ----
PORT=3000
DB_POOL_MAX=10                  # pg pool size per app instance (keep instances × DB_POOL_MAX below the server's max_connections)
APP_TIMEZONE=Asia/Seoul         # session time zone for CURRENT_DATE / date casts (Health, attention, reports)
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/relai_test   # npm test (each test file isolates itself in a temporary schema)

# ---- AI Productivity Layer (Phase 11) — optional; without a provider key every AI button is hidden and the rest of RELAI is unaffected ----
AI_ENABLED=true                 # false hides/blocks all AI features even when a key is set
AI_PROVIDER=anthropic           # anthropic | openai  (tests use `fake`)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=                       # default: claude-sonnet-4-5 (anthropic) / gpt-4o-mini (openai)
AI_REQUEST_TIMEOUT_MS=25000     # provider timeout per call (one retry on transient 429/5xx, never on timeout)
AI_DAILY_LIMIT=300              # AI requests per workspace per day (0 = unlimited)
AI_USER_MINUTE_LIMIT=10         # AI requests per user per minute (0 = unlimited)
AI_MAX_INPUT_CHARS=20000        # max pasted text per request
AI_INITIAL_TRIAL_CREDITS=100    # production: one-time trial credits (PROMOTION) when a workspace's credit account is first created. 0 = none
DEV_INITIAL_AI_CREDITS=         # dev/test only: when > 0 it replaces the trial grant (PLAN_GRANT). Leave unset in production.
# Feature credit costs (development defaults, change here or override per feature): AI_CREDIT_COST_REQUIREMENT_EXTRACTION=10 AI_CREDIT_COST_WBS_GENERATION=15 AI_CREDIT_COST_CHANGE_IMPACT=8 AI_CREDIT_COST_PROJECT_QA=3

# ---- Jira Cloud integration (Phase 12) — optional; without these the Integrations card shows "서버 설정 필요" and nothing else changes ----
ATLASSIAN_CLIENT_ID=            # Atlassian Developer Console → OAuth 2.0 (3LO) app → Settings
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=         # e.g. https://relai.example.com/api/integrations/jira/callback (must match the app's Authorization callback URL)
APP_BASE_URL=                   # public https base URL of this server (webhook callback + links in Jira issues); defaults to the redirect URI's origin
# ATLASSIAN_SCOPES=read:jira-work write:jira-work read:jira-user manage:jira-webhook offline_access   # default; must match the app's granted scopes
INTEGRATION_ENCRYPTION_KEY=     # 32-byte key (hex/base64) for AES-256-GCM token encryption. REQUIRED in production; dev derives one from SESSION_SECRET
# INTEGRATION_SCHEDULER_INTERVAL_MIN=0   # >0 runs reconciliation in-process (single instance only). Recommended: cron `node scripts/integration-cron.js` every 15 min
# INTEGRATION_SYNC_STALE_MIN=30          # reconciliation re-syncs projects whose last sync is older than this
# INTEGRATION_PROVIDER=live              # fake = in-memory Jira for local demos/tests (no network)
