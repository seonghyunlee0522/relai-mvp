{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node server/build-static.js",
  "outputDirectory": ".vercel-static",
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,server}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/integrations",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/billing/cron/daily",
      "schedule": "0 0 * * *"
    }
  ]
}
