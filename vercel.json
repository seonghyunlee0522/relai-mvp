{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".vercel-static",
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,server}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/integrations",
      "schedule": "0 19 * * *"
    }
  ]
}
