{
  "name": "relai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test --test-force-exit \"server/test/*.test.js\"",
    "migrate:sqlite": "node --env-file-if-exists=.env scripts/migrate-sqlite-to-postgres.js",
    "samples:build": "node --env-file-if-exists=.env scripts/build-sample-snapshot.mjs",
    "db:validate": "node --env-file-if-exists=.env scripts/migrate-sqlite-to-postgres.js --validate"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.1",
    "docx": "^9.11.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jose": "^5.10.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  }
}
